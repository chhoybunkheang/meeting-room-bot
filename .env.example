# Copy this file to .env and replace every placeholder.

BOT_TOKEN=your_botfather_token
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database
MINI_APP_URL=https://your-web-service.example.com
GROUP_CHAT_ID=-1001234567890
ADMIN_ID=123456789
MEETING_TIMEZONE=Asia/Phnom_Penh

# Reject signed Telegram Mini App data older than this many seconds.
TELEGRAM_INIT_DATA_MAX_AGE=3600

# Polling is recommended when the bot runs as a separate worker.
USE_WEBHOOK=false

# Required only when USE_WEBHOOK=true.
WEBHOOK_URL=https://your-bot-service.example.com
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBHOOK_SECRET_TOKEN=replace-with-a-random-secret
